# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
#
# Trên GitHub Actions, 4 biến dưới đây khai báo tại:
#   Settings > Secrets and variables > Actions > Repository secrets
# Riêng SHEET_NAME được workflow set thẳng cho từng job
# (Sheet1 cho máy lọc KK, raw_RAC cho máy lạnh) nên không cần tạo secret.

# --- Google Sheets ---
# Nội dung JSON của service account (dán nguyên cả file khi tạo secret)
GOOGLE_SERVICE_ACCOUNT_JSON=
# URL Google Sheet đích — cả 2 scraper dùng chung 1 spreadsheet, khác tab
SPREADSHEET_URL=
# Tên tab ghi dữ liệu. Chỉ cần set khi chạy local:
#   Sheet1  -> full_colab_scraper.py  (máy lọc không khí + máy hút ẩm)
#   raw_RAC -> lg_ac_colab_scraper.py (máy lạnh)
SHEET_NAME=

# --- Telegram ---
# Lấy từ @BotFather. Nếu token từng bị lộ, dùng /revoke để cấp token mới.
TELEGRAM_BOT_TOKEN=
# ID chat/nhóm nhận thông báo
TELEGRAM_CHAT_ID=
