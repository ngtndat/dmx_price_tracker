# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Trên GitHub, khai báo các biến này tại: Settings > Secrets and variables > Actions

# --- Google Sheets ---
# Nội dung JSON của service account (dán nguyên 1 dòng khi dùng làm secret)
GOOGLE_SERVICE_ACCOUNT_JSON=
# URL Google Sheet đích (mỗi scraper một sheet riêng)
SPREADSHEET_URL=
# Tên tab ghi dữ liệu: "Sheet1" cho máy lọc KK, "raw_RAC" cho máy lạnh
SHEET_NAME=

# --- Telegram ---
# Lấy từ @BotFather. Nếu token từng bị lộ, dùng /revoke để cấp token mới.
TELEGRAM_BOT_TOKEN=
# ID chat/nhóm nhận thông báo
TELEGRAM_CHAT_ID=
